# ============================================
# Exemple de configuration - copier vers .env
# puis renseigner les valeurs reelles :
#   cp .env.example .env
# ============================================

# Cle API Exchangerate-API : https://app.exchangerate-api.com
EXCHANGE_RATE_API_KEY=votre_cle_api_ici

# URL de base de l API de taux de change (optionnel)
EXCHANGE_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6

# Duree de mise en cache des taux en minutes (optionnel)
EXCHANGE_RATE_CACHE_MINUTES=60

# Port HTTP de l application (optionnel)
SERVER_PORT=8080
